include_guard(GLOBAL)

# Profiles opt into engine fragments and may override their neutral material hooks.
# Other shader includes remain for the native shader compiler to resolve.
function(phlosion_expand_material_source SOURCE_TEXT SOURCE_DIRECTORY OUT_VAR)
    _phlosion_expand_material_source("${SOURCE_TEXT}" "${SOURCE_DIRECTORY}" "" _expanded)
    set(${OUT_VAR} "${_expanded}" PARENT_SCOPE)
endfunction()

function(_phlosion_expand_material_source SOURCE_TEXT SOURCE_DIRECTORY ACTIVE_PATHS OUT_VAR)
    get_filename_component(_engine_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(_fragments "${_engine_root}/assets/shaders/materials")
    set(_text "${SOURCE_TEXT}")
    while(_text MATCHES "#include[ \t]+\"(phlosion|material)/([^\"]+)\"[ \t]*\r?\n?")
        set(_include "${CMAKE_MATCH_0}")
        set(_namespace "${CMAKE_MATCH_1}")
        set(_name "${CMAKE_MATCH_2}")
        if(NOT _name MATCHES "^[A-Za-z0-9_]+\\.(glsl|hlsl)$")
            message(FATAL_ERROR "Invalid material fragment path: ${_namespace}/${_name}")
        endif()
        if(_namespace STREQUAL "phlosion")
            set(_path "${_fragments}/${_name}")
        elseif(EXISTS "${SOURCE_DIRECTORY}/material/${_name}")
            set(_path "${SOURCE_DIRECTORY}/material/${_name}")
        else()
            set(_path "${_fragments}/defaults/${_name}")
        endif()
        if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
            message(FATAL_ERROR "Missing material fragment: ${_path}")
        endif()
        list(FIND ACTIVE_PATHS "${_path}" _cycle_index)
        if(NOT _cycle_index EQUAL -1)
            message(FATAL_ERROR "Cyclic material fragment: ${_path}")
        endif()
        set(_active "${ACTIVE_PATHS}")
        list(APPEND _active "${_path}")
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
        endif()
        file(READ "${_path}" _fragment)
        _phlosion_expand_material_source("${_fragment}" "${SOURCE_DIRECTORY}" "${_active}" _fragment)
        string(REPLACE "${_include}" "${_fragment}" _text "${_text}")
    endwhile()
    set(${OUT_VAR} "${_text}" PARENT_SCOPE)
endfunction()
