cmake_minimum_required(VERSION 3.22)
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
set(_src "${TEST_ROOT}/source")
set(_build "${TEST_ROOT}/build")
file(WRITE "${_src}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
project(ShaderBuildContract NONE)
include("${PHLOSION_ROOT}/cmake/ComposeMaterialProfile.cmake")
function(finish_profile output)
    file(APPEND "${output}/d3d12_declarations.hlsl" "\n// final composed contents\n")
endfunction()
phlosion_compose_material_profile(TARGET Profile
    OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/profile"
    SOURCE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/profile"
    POST_COMPOSE finish_profile)
phlosion_compose_material_profile(TARGET Transparent DIRECT_TRANSPARENT
    OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/transparent"
    SOURCE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/profile")
foreach(name IN ITEMS dependent independent)
    phlosion_compile_vulkan_shader(SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/${name}.vert"
        OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${name}.spv"
        OPTIONS "-I${CMAKE_CURRENT_SOURCE_DIR}")
endforeach()
add_custom_target(Check ALL DEPENDS Transparent
    "${CMAKE_CURRENT_BINARY_DIR}/dependent.spv"
    "${CMAKE_CURRENT_BINARY_DIR}/independent.spv")
]=])
file(MAKE_DIRECTORY "${_src}/profile")
foreach(api IN ITEMS opengl d3d12 world world_indirect)
    set(ext glsl)
    if(api STREQUAL d3d12)
        set(ext hlsl)
    endif()
    foreach(part IN ITEMS declarations evaluation vertex_declarations vertex_evaluation)
        file(WRITE "${_src}/profile/${api}_${part}.${ext}" "// base profile\n")
    endforeach()
endforeach()
file(WRITE "${_src}/profile/world_declarations.glsl" "#include \"phlosion/surface_color.glsl\"\n")
file(WRITE "${_src}/nested.glsl" "const float value=1.0;\n")
file(WRITE "${_src}/shared.glsl" "#include \"nested.glsl\"\n")
file(WRITE "${_src}/dependent.vert" "#version 450\n#extension GL_GOOGLE_include_directive : require\n#include \"shared.glsl\"\nvoid main(){gl_Position=vec4(value);}\n")
file(WRITE "${_src}/independent.vert" "#version 450\nvoid main(){gl_Position=vec4(0);}\n")
function(run label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${TEST_ROOT}/${label}.log" "${out}\n${err}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label}: ${out}\n${err}")
    endif()
endfunction()
set(configure "${CMAKE_COMMAND}" -S "${_src}" -B "${_build}"
    -G "${TEST_GENERATOR}" "-DPHLOSION_ROOT=${PHLOSION_ROOT}"
    "-DPHLOSION_GLSLANG_VALIDATOR=${PHLOSION_GLSLANG_VALIDATOR}")
if(TEST_PLATFORM)
    list(APPEND configure -A "${TEST_PLATFORM}")
endif()
set(build "${CMAKE_COMMAND}" --build "${_build}" --config Release --target Check)
run(configure ${configure})
run(first ${build})
file(GLOB family_programs "${_build}/transparent/*.spv")
list(LENGTH family_programs family_count)
if(NOT family_count EQUAL 3)
    message(FATAL_ERROR "Transparent family must compile exactly three direct programs")
endif()

file(TIMESTAMP "${_build}/dependent.spv" dependent_before "%s")
file(TIMESTAMP "${_build}/independent.spv" independent_before "%s")
file(TIMESTAMP "${_build}/profile/d3d12_declarations.hlsl" profile_before "%s")
file(READ "${_build}/profile/d3d12_declarations.hlsl" final)
if(NOT final MATCHES "// final composed contents")
    message(FATAL_ERROR "Post-composition hook was not published")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
run(reconfigure ${configure})
run(noop ${build})
foreach(name IN ITEMS dependent independent)
    file(TIMESTAMP "${_build}/${name}.spv" now "%s")
    if(NOT now STREQUAL ${name}_before)
        message(FATAL_ERROR "Unchanged shader was rebuilt: ${name}")
    endif()
endforeach()
file(TIMESTAMP "${_build}/profile/d3d12_declarations.hlsl" now "%s")
if(NOT now STREQUAL profile_before)
    message(FATAL_ERROR "Intermediate composition rewrote an unchanged published file")
endif()
file(WRITE "${_src}/nested.glsl" "const float value=2.0;\n")
run(nested ${build})
file(TIMESTAMP "${_build}/dependent.spv" now "%s")
file(TIMESTAMP "${_build}/independent.spv" other "%s")
if(now STREQUAL dependent_before OR NOT other STREQUAL independent_before)
    message(FATAL_ERROR "Nested include did not rebuild exactly its consumer")
endif()
file(WRITE "${_src}/added.glsl" "const float extra=0.0;\n")
file(APPEND "${_src}/shared.glsl" "#include \"added.glsl\"\n")
run(add-include ${build})
file(TIMESTAMP "${_build}/dependent.spv" before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
file(WRITE "${_src}/added.glsl" "const float extra=1.0;\n")
run(change-added ${build})
file(TIMESTAMP "${_build}/dependent.spv" now "%s")
if(now STREQUAL before)
    message(FATAL_ERROR "New include was absent from subsequent dependencies")
endif()
file(APPEND "${_src}/shared.glsl" "#include \"missing.glsl\"\n")
execute_process(COMMAND ${build} RESULT_VARIABLE rejected OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/missing-include.log" "${out}\n${err}")
if(rejected EQUAL 0)
    message(FATAL_ERROR "Missing include silently reused stale shader")
endif()
message(STATUS "Stable composition, no-op build, transitive/new/missing includes passed")
