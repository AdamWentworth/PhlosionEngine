#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
layout(set=0,binding=0)uniform sampler2D depthTexture;
layout(set=0,binding=1)uniform sampler2D historyTexture;
layout(set=0,binding=2)uniform sampler2D currentTexture;
layout(set=0,binding=3)uniform sampler2D maximumDepth;
layout(set=0,binding=4)uniform sampler2D shadowTexture;
layout(std430,set=0,binding=5)readonly buffer Transport{vec4 transport[];};
layout(std430,set=0,binding=6)readonly buffer Radiance{vec4 radiance[];};
layout(rgba16f,set=0,binding=7)uniform writeonly image2D outputTexture;
layout(r32f,set=0,binding=8)uniform writeonly image2D depthOutput;
layout(std140,set=0,binding=9)uniform Parameters{vec4 parameters[672];};
layout(set=0,binding=10)uniform sampler2D cloudShadowTexture;
#define VP_CLOUD_SHADOW(uv) textureLod(cloudShadowTexture,uv,0.0).r
layout(set=0,binding=11)uniform sampler2DShadow sunShadowTexture;
#define VP_SUN_COMPARE(uv,z) textureLod(sunShadowTexture,vec3(uv,z),0.0)
#define VP(i) parameters[i]
#define WORLD_GI_DATA(i) transport[i]
#define WORLD_GI_RESULT(i) radiance[i]
#define WORLD_GI_LOOP [[dont_unroll]]
#define VP_SHARED shared
#define VP_LOOP [[dont_unroll]]
#define VP_BARRIER barrier()
#define VP_DEPTH(p) texelFetch(depthTexture,p,0).r
#define VP_HISTORY(uv) textureLod(historyTexture,uv,0.0)
#define VP_CURRENT(p) texelFetch(currentTexture,p,0)
#define VP_MAX_DEPTH(p) texelFetch(maximumDepth,p,0).r
#define VP_SHADOW(uv) textureLod(shadowTexture,uv,0.0).r
#define VP_STORE(p,v) imageStore(outputTexture,p,v)
#define VP_STORE_DEPTH(p,v) imageStore(depthOutput,p,vec4(v))
#include "precipitation_lighting.glsl"
#if VP_STAGE==1
layout(local_size_x=4,local_size_y=4,local_size_z=4)in;
void main(){volumeLight(ivec3(gl_GlobalInvocationID),ivec3(gl_WorkGroupID),gl_LocalInvocationIndex);}
#else
layout(local_size_x=8,local_size_y=8,local_size_z=1)in;
void main(){
#if VP_STAGE==0
volumeMaximumDepth(ivec2(gl_GlobalInvocationID.xy));
#else
volumeScatter(ivec2(gl_GlobalInvocationID.xy));
#endif
}
#endif
