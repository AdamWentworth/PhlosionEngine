#version 450
#extension GL_GOOGLE_include_directive:require
#extension GL_EXT_control_flow_attributes:require
layout(local_size_x=8,local_size_y=8,local_size_z=1)in;
layout(set=0,binding=15)uniform Params{vec4 rows[32];};
#define CP(i) rows[i]
#define CONTACT_LOOP [[dont_unroll]]
layout(set=0,binding=0)uniform sampler2D s0;
layout(set=0,binding=1)uniform sampler2D s1;
layout(set=0,binding=2)uniform sampler2D s2;
layout(set=0,binding=3)uniform usampler2D s3;
layout(set=0,binding=4)uniform sampler2D s4;
layout(set=0,binding=5)uniform sampler2D s5;
layout(set=0,binding=6)uniform sampler2D s6;
layout(set=0,binding=7)uniform sampler2D s7;
layout(set=0,binding=8)uniform sampler2D s8;
layout(set=0,binding=9)uniform sampler2D s9;
layout(set=0,binding=10)uniform sampler2D s10;
layout(set=0,binding=11,rgba8)uniform writeonly image2D out0;
layout(set=0,binding=12,r32f)uniform writeonly image2D out1;
layout(set=0,binding=13,rg16f)uniform writeonly image2D out2;
layout(set=0,binding=14,rgba8)uniform writeonly image2D out3;
#define FULL_DEPTH(q) texelFetch(s0,q,0).r
#define FULL_NORMAL(q) texelFetch(s1,q,0)
#define FULL_VELOCITY(q) texelFetch(s2,q,0)
#define FULL_FLAGS(q) (texelFetch(s3,q,0).g>>16u)
#define HALF_DEPTH(q) texelFetch(s4,q,0).r
#define HALF_NORMAL(q) texelFetch(s5,q,0)
#define HALF_VELOCITY(q) texelFetch(s6,q,0).rg
#define CONE_LOAD(q) texelFetch(s7,q,0)
#define PREV_DEPTH(uv) textureLod(s8,uv,0).r
#define PREV_VELOCITY(uv) textureLod(s9,uv,0).rg
#define PREV_CONE(uv) textureLod(s10,uv,0)
#define STORE_CONE(q,v) imageStore(out0,q,v)
#define STORE_DEPTH(q,v) imageStore(out1,q,vec4(v))
#define STORE_VELOCITY(q,v) imageStore(out2,q,vec4(v,0,0))
#define STORE_NORMAL(q,v) imageStore(out3,q,v)
#include "world_contact_compute.glsl"
void main(){contactCompute(ivec2(gl_GlobalInvocationID.xy));}
